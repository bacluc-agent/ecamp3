fluent-operator:
  containerRuntime: containerd
  operator: 
    annotations:
      trigger-recreate: {{ exec "uuidgen" (list) }}
    container:
      # renovate: datasource=docker depName=ghcr.io/fluent/fluent-operator/fluent-operator
      tag: "v3.7.0"
  fluentbit:
    enable: true
    input:
      tail:
        enable: true
      systemd:
        enable: false
    filter:
      kubernetes:
        labels: true
        annotations: true
    output:
      stdout: 
        # enable to debug fluentbit
        enable: false
  fluentd:
    forward:
      retainMetadataInForwardMode: false
    image:
      # renovate: datasource=docker depName=ghcr.io/fluent/fluent-operator/fluentd
      tag: "v1.17.1"
    watchedNamespaces:
      - api-gateway
      - external-dns-gateway-api
      - default
    envVars: 
      - name: TRIGGER_FLUENTD_RECREATE
        value: {{ exec "uuidgen" (list) }}
    enable: true

fluentd:
  output:
    loki:
      enable: true
      url: "http://loki.ecamp3-logging.svc.cluster.local:3100"
    elasticsearch:
      enable: false

# ponytail: Elasticsearch and Kibana removed; Loki is the lightweight sink
# elastic: ... (disabled)
# kibana: ... (disabled)
